---
import AccountHeader from '../components/account/AccountHeader.astro';
import AccountNav from '../components/account/AccountNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="account-header">
      <AccountHeader />
    </header>
    <nav class="account-nav" aria-label="Account">
      <AccountNav />
    </nav>
    <main class="account-main wrapper">
      <slot />
    </main>
  </body>
</html>

<script>
  import { gateAccountPage } from '../lib/accountGate';
  gateAccountPage();
</script>
