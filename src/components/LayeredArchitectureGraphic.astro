---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class={`layered-graphic ${className}`}
  viewBox="0 0 640 460"
  role="img"
  aria-labelledby="layered-graphic-title"
>
  <title id="layered-graphic-title">Fragmented product silos converging into a single shared platform</title>

  <!-- Fragmented silo layer -->
  <g stroke="#94a3b8" stroke-width="1.5" fill="none">
    <rect x="40" y="36" width="120" height="72" />
    <rect x="188" y="20" width="120" height="88" />
    <rect x="336" y="44" width="120" height="64" />
    <rect x="480" y="28" width="120" height="80" />
  </g>
  <g fill="#1e293b">
    <rect x="52" y="52" width="96" height="6" />
    <rect x="52" y="66" width="64" height="6" />
    <rect x="200" y="40" width="96" height="6" />
    <rect x="200" y="54" width="72" height="6" />
    <rect x="200" y="68" width="52" height="6" />
    <rect x="348" y="58" width="96" height="6" />
    <rect x="348" y="72" width="60" height="6" />
    <rect x="492" y="46" width="96" height="6" />
    <rect x="492" y="60" width="80" height="6" />
    <rect x="492" y="74" width="48" height="6" />
  </g>

  <!-- Convergence lines: sharp, architectural, no curves -->
  <g stroke="#334155" stroke-width="1.5">
    <line x1="100" y1="108" x2="220" y2="248" />
    <line x1="248" y1="108" x2="280" y2="248" />
    <line x1="396" y1="108" x2="360" y2="248" />
    <line x1="540" y1="108" x2="420" y2="248" />
  </g>

  <!-- Shared platform infrastructure -->
  <rect x="60" y="248" width="520" height="120" fill="#0a192f" stroke="#0a192f" />
  <g stroke="#334155" stroke-width="1">
    <line x1="180" y1="248" x2="180" y2="368" />
    <line x1="320" y1="248" x2="320" y2="368" />
    <line x1="460" y1="248" x2="460" y2="368" />
  </g>
  <g fill="#f8fafc">
    <rect x="88" y="296" width="60" height="6" />
    <rect x="212" y="296" width="80" height="6" />
    <rect x="360" y="296" width="72" height="6" />
    <rect x="492" y="296" width="60" height="6" />
  </g>

  <!-- Foundation -->
  <rect x="20" y="392" width="600" height="10" fill="#000000" />
  <rect x="20" y="410" width="600" height="4" fill="#94a3b8" />
</svg>

<style>
  .layered-graphic {
    width: 100%;
    height: auto;
  }
</style>
