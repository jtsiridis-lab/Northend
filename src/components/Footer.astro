---
const playbooks = [
  { label: 'EBITDA Defense', href: '/playbooks/ebitda-defense' },
  { label: 'AI Monetization', href: '/playbooks/ai-monetization' },
  { label: 'NRR Acceleration', href: '/playbooks/nrr-acceleration' },
  { label: 'Platform Convergence', href: '/playbooks/platform-convergence' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrapper footer-grid">
    <div>
      <p class="brand">North End<span>Technology</span></p>
      <p class="tagline">Product &amp; platform advisory for PE-backed software operators.</p>
    </div>

    <div>
      <p class="col-heading">Playbooks</p>
      <ul>
        {playbooks.map((p) => (
          <li><a href={p.href}>{p.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="col-heading">Company</p>
      <ul>
        <li><a href="/#about">About</a></li>
        <li><a href="/#contact">Contact</a></li>
        <li><a href="mailto:info@northendtechnology.com">info@northendtechnology.com</a></li>
      </ul>
    </div>
  </div>

  <div class="wrapper footer-bottom">
    <p>&copy; {year} North End Technology. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-charcoal);
    color: var(--color-text-muted);
    padding-top: 64px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 48px;
  }

  .brand {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-white);
    margin-bottom: 12px;
  }

  .brand span {
    color: var(--color-text-muted);
    font-weight: 500;
    margin-left: 6px;
  }

  .tagline {
    max-width: 32ch;
    font-size: 0.9rem;
  }

  .col-heading {
    color: var(--color-white);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 16px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  ul a {
    font-size: 0.9rem;
  }

  ul a:hover {
    color: var(--color-white);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: 24px 0;
    font-size: 0.8rem;
  }

  @media (max-width: 700px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
