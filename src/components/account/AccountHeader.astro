---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="wrapper account-header__inner">
  <div class="account-header__brand">
    <a href={`${base}/`} class="brand">North End<span>Technology</span></a>
    <span class="account-header__engagement">Acme SaaS — Platform Convergence Engagement</span>
  </div>

  <div class="account-header__actions">
    <details class="account-menu">
      <summary aria-label="Notifications">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path
            d="M9 2.5c-2.2 0-4 1.8-4 4v2.3c0 .5-.2 1-.5 1.4L3.5 11.5c-.5.6-.1 1.5.7 1.5h9.6c.8 0 1.2-.9.7-1.5l-1-1.3c-.3-.4-.5-.9-.5-1.4V6.5c0-2.2-1.8-4-4-4Z"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
          <path d="M7.5 14.5a1.5 1.5 0 0 0 3 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
        <span class="account-menu__dot"></span>
      </summary>
      <div class="account-menu__panel">
        <p class="account-menu__title">Notifications</p>
        <p class="account-menu__item">Your Sept 18 steering review has been confirmed.</p>
      </div>
    </details>

    <details class="account-menu">
      <summary>
        <span data-user-name>Client User</span>
      </summary>
      <div class="account-menu__panel">
        <a href={`${base}/account/settings#profile`}>Profile</a>
        <a href={`${base}/account/settings`}>Settings</a>
        <button type="button" data-account-signout>Sign Out</button>
      </div>
    </details>
  </div>
</div>

<style>
  .account-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 72px;
  }

  .account-header__brand {
    display: flex;
    align-items: baseline;
    gap: 16px;
    min-width: 0;
  }

  .account-header__brand .brand {
    color: var(--color-white);
    font-weight: 700;
    white-space: nowrap;
  }

  .account-header__brand .brand span {
    color: var(--color-text-muted);
    font-weight: 500;
    margin-left: 6px;
  }

  .account-header__engagement {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .account-header__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .account-menu {
    position: relative;
  }

  .account-menu summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-white);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    padding: 8px 10px;
    border-radius: var(--radius);
    position: relative;
  }

  .account-menu summary::-webkit-details-marker {
    display: none;
  }

  .account-menu[open] summary {
    background: var(--color-slate);
  }

  .account-menu__dot {
    position: absolute;
    top: 4px;
    right: 2px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-white);
    border: 1.5px solid var(--color-navy);
  }

  .account-menu__panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 240px;
    background: var(--color-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.18);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 20;
  }

  .account-menu__title {
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted-on-light);
    padding: 4px 8px;
    margin: 0;
  }

  .account-menu__item {
    font-size: 0.9rem;
    color: var(--color-charcoal);
    padding: 6px 8px;
    margin: 0;
  }

  .account-menu__panel a,
  .account-menu__panel button {
    display: block;
    width: 100%;
    text-align: left;
    font-size: 0.9rem;
    color: var(--color-charcoal);
    padding: 8px;
    border-radius: var(--radius);
    background: none;
    border: none;
    font-family: var(--font-sans);
    cursor: pointer;
  }

  .account-menu__panel a:hover,
  .account-menu__panel button:hover {
    background: var(--color-soft-gray);
  }

  @media (max-width: 700px) {
    .account-header__engagement {
      display: none;
    }
  }
</style>
