# Auth0 SPA application (Application type: Single Page Application)
PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
PUBLIC_AUTH0_CLIENT_ID=your-auth0-client-id
PUBLIC_AUTH0_REDIRECT_URI=https://northendtechnology.com/

# Formspree form endpoint id (Formspree form configured to notify info@northendtechnology.com)
PUBLIC_FORMSPREE_FORM_ID=your-formspree-form-id
